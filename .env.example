# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DATABASE_NAME=picture-scramble

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TIMEOUT_BASE=20000
OPENAI_TIMEOUT_EXP=2000
OPENAI_MAX_RETRIES=4
OPENAI_MAX_TOKENS=1000
RESPONSE_MIN_TOKENS=200

# Game Configuration
EASY_GAMES_COUNT=3
WORD_LENGTH_MAX=9

# Prompts
GENERATE_WORD_PROMPT_CONCRETE="Generate a single easy English word (a concrete noun, color, or simple action) that is between 4 and 9 letters long. Reply with ONLY the word, nothing else."
GENERATE_WORD_PROMPT_ABSTRACT="Generate a single English word (can be abstract, unusual, or challenging) that is between 4 and 9 letters long. Reply with ONLY the word, nothing else."
GENERATE_WORD_PROMPT_TOPIC="Generate a single English word related to the topic '%TOPIC%' that is between 4 and 9 letters long. Reply with ONLY the word, nothing else."
GENERATE_COMPLIMENT="Generate a short, fun compliment (under 10 words) for someone who just solved the word '%WORD%'. Reply with ONLY the compliment."

# Default Contact Info
DEFAULT_NAME=
DEFAULT_PHONE=
DEFAULT_INSTAGRAM=
DEFAULT_CONTACT_INFO=

# Upload
UPLOAD_KEY=your-secret-upload-key

# Server
PORT=3000
BASE_URL=http://localhost:3000
